<Window
    x:Class="StudentManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Student Management System"
    Width="1200"
    Height="750"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header (Step 17) -->
        <Border
            Grid.Row="0"
            Background="#1565C0"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,0,15">
            <StackPanel>
                <TextBlock
                    Text="STUDENT MANAGEMENT SYSTEM"
                    Foreground="White"
                    FontSize="28"
                    FontWeight="Bold"/>
                <TextBlock
                    Text="Manage student data"
                    Foreground="White"
                    FontSize="14"
                    Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- Form + Info Panel (Step 18, 19, 20) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Input -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock Text="NIM" Margin="0,0,0,4"/>
                <TextBox
                    Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,8"/>

                <TextBlock Text="Nama" Margin="0,0,0,4"/>
                <TextBox
                    Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,8"/>

                <TextBlock Text="Jurusan" Margin="0,0,0,4"/>
                <ComboBox
                    SelectedValuePath="Content" SelectedValue="{Binding SelectedStudent.Jurusan, Mode=TwoWay}"
                    Margin="0,0,0,8">
                    <ComboBoxItem>Informatika</ComboBoxItem>
                    <ComboBoxItem>Sistem Informasi</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Gender" Margin="0,0,0,4"/>
                <ComboBox
                    SelectedValuePath="Content" SelectedValue="{Binding SelectedStudent.Gender, Mode=TwoWay}"
                    Margin="0,0,0,8">
                    <ComboBoxItem>Laki-laki</ComboBoxItem>
                    <ComboBoxItem>Perempuan</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Email" Margin="0,0,0,4"/>
                <TextBox
                    Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,12"/>

                <!-- Buttons (Step 19) -->
                <StackPanel Orientation="Horizontal">
                    <Button
                        Content="Simpan"
                        Command="{Binding SaveCommand}"
                        Background="#1976D2"
                        Foreground="White"
                        Padding="20,10"
                        Margin="0,0,8,0"/>
                    <Button
                        Content="Hapus"
                        Command="{Binding DeleteCommand}"
                        Padding="20,10"
                        Margin="0,0,8,0"/>
                    <Button
                        Content="Reset"
                        Command="{Binding ResetCommand}"
                        Padding="20,10"/>
                </StackPanel>
            </StackPanel>

            <!-- Information Panel (Step 20) -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="INFORMASI" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Total Mahasiswa"/>
                <TextBlock Text="{Binding TotalStudents}" FontSize="32" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Informatika"/>
                <TextBlock Text="{Binding TotalInformatika}" FontSize="24" Margin="0,0,0,8"/>

                <TextBlock Text="Sistem Informasi"/>
                <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="24" Margin="0,0,0,8"/>

                <TextBlock Text="Laki-laki"/>
                <TextBlock Text="{Binding TotalLakiLaki}" FontSize="24" Margin="0,0,0,8"/>

                <TextBlock Text="Perempuan"/>
                <TextBlock Text="{Binding TotalPerempuan}" FontSize="24"/>
            </StackPanel>
        </Grid>

        <!-- Search (Step 21) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                Width="400"
                Padding="10"
                Margin="0,0,8,0"/>
            <Button
                Content="Cari"
                Command="{Binding SearchCommand}"
                Padding="25,10"/>
        </StackPanel>

        <!-- DataGrid (Step 22) -->
        <DataGrid
            Grid.Row="3"
            ItemsSource="{Binding Students}"
            SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
            AutoGenerateColumns="False"
            IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NIM"     Binding="{Binding NIM}"     Width="120"/>
                <DataGridTextColumn Header="Nama"    Binding="{Binding Nama}"    Width="*"/>
                <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="*"/>
                <DataGridTextColumn Header="Gender"  Binding="{Binding Gender}"  Width="100"/>
                <DataGridTextColumn Header="Email"   Binding="{Binding Email}"   Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>

